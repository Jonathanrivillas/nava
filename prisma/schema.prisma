// Prisma schema — Nava
// Modelo de datos: ver plan del proyecto, sección 5.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Rol {
  CLIENTE
  ADMIN_SOCIO
}

enum TipoProducto {
  PROPIO
  DROPSHIPPING
}

enum TipoOferta {
  PORCENTAJE
  MONTO_FIJO
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  CONTRA_ENTREGA
  TRANSFERENCIA
  PASARELA_ONLINE
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
}

enum TipoMovimientoFidelidad {
  ACUMULADO
  CANJEADO
}

// ---------- Entidades ----------

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  telefono     String?
  rol          Rol      @default(CLIENTE)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pedidos    Pedido[]
  fidelidad  Fidelidad?

  @@map("usuarios")
}

model Distribuidor {
  id        String   @id @default(cuid())
  nombre    String
  contacto  String?
  direccion String?
  notas     String?
  createdAt DateTime @default(now()) @map("created_at")

  productos Producto[]
  compras   CompraDistribuidor[]

  @@map("distribuidores")
}

model Marca {
  id     String @id @default(cuid())
  nombre String @unique

  productos Producto[]

  @@map("marcas")
}

model Categoria {
  id               String  @id @default(cuid())
  nombre           String
  categoriaPadreId String? @map("categoria_padre_id")

  categoriaPadre Categoria?  @relation("CategoriaJerarquia", fields: [categoriaPadreId], references: [id])
  subcategorias  Categoria[] @relation("CategoriaJerarquia")
  productos      Producto[]

  @@index([categoriaPadreId])
  @@map("categorias")
}

model Producto {
  id               String       @id @default(cuid())
  nombre           String
  marcaId          String       @map("marca_id")
  categoriaId      String       @map("categoria_id")
  descripcion      String?
  precioVenta      Decimal      @map("precio_venta") @db.Decimal(10, 2)
  precioCompra     Decimal?     @map("precio_compra") @db.Decimal(10, 2)
  tipo             TipoProducto @default(PROPIO)
  distribuidorId   String?      @map("distribuidor_id")
  stock            Int          @default(0)
  imagenPrincipal  String?      @map("imagen_principal")
  activo           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  marca        Marca        @relation(fields: [marcaId], references: [id])
  categoria    Categoria    @relation(fields: [categoriaId], references: [id])
  distribuidor Distribuidor? @relation(fields: [distribuidorId], references: [id])

  imagenes               ImagenProducto[]
  ofertas                Oferta[]
  pedidoItems            PedidoItem[]
  comprasDistribuidor    CompraDistribuidor[]
  movimientosInventario  MovimientoInventario[]

  @@index([marcaId])
  @@index([categoriaId])
  @@index([distribuidorId])
  @@index([tipo])
  @@index([activo])
  @@map("productos")
}

model ImagenProducto {
  id         String @id @default(cuid())
  productoId String @map("producto_id")
  url        String
  orden      Int    @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@map("imagenes_producto")
}

model Oferta {
  id          String     @id @default(cuid())
  productoId  String     @map("producto_id")
  tipo        TipoOferta
  valor       Decimal    @db.Decimal(10, 2)
  fechaInicio DateTime   @map("fecha_inicio")
  fechaFin    DateTime   @map("fecha_fin")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@map("ofertas")
}

model Banner {
  id          String    @id @default(cuid())
  imagenUrl   String    @map("imagen_url")
  texto       String?
  link        String?
  orden       Int       @default(0)
  fechaInicio DateTime? @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  activo      Boolean   @default(true)

  @@map("banners")
}

model Pedido {
  id               String       @id @default(cuid())
  userId           String?      @map("user_id")
  nombreContacto   String       @map("nombre_contacto")
  telefonoContacto String       @map("telefono_contacto")
  emailContacto    String?      @map("email_contacto")
  esInvitado       Boolean      @default(false) @map("es_invitado")
  estado           EstadoPedido @default(PENDIENTE)
  subtotal         Decimal      @db.Decimal(10, 2)
  costoEnvio       Decimal      @default(0) @map("costo_envio") @db.Decimal(10, 2)
  total            Decimal      @db.Decimal(10, 2)
  direccionEnvio   String       @map("direccion_envio")
  metodoPago       MetodoPago   @map("metodo_pago")
  fecha            DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])

  items                 PedidoItem[]
  movimientosFidelidad  MovimientoFidelidad[]

  @@index([userId])
  @@index([telefonoContacto])
  @@index([estado])
  @@map("pedidos")
}

model PedidoItem {
  id             String  @id @default(cuid())
  pedidoId       String  @map("pedido_id")
  productoId     String  @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@index([productoId])
  @@map("pedido_items")
}

model CompraDistribuidor {
  id             String   @id @default(cuid())
  distribuidorId String   @map("distribuidor_id")
  productoId     String   @map("producto_id")
  cantidad       Int
  costoUnitario  Decimal  @map("costo_unitario") @db.Decimal(10, 2)
  fecha          DateTime @default(now())

  distribuidor Distribuidor @relation(fields: [distribuidorId], references: [id])
  producto     Producto     @relation(fields: [productoId], references: [id])

  @@index([distribuidorId])
  @@index([productoId])
  @@map("compras_distribuidor")
}

model MovimientoInventario {
  id         String                   @id @default(cuid())
  productoId String                   @map("producto_id")
  tipo       TipoMovimientoInventario
  cantidad   Int
  motivo     String?
  fecha      DateTime                 @default(now())

  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId])
  @@map("movimientos_inventario")
}

// Indexado por telefono (no solo por userId) para que compras como invitado
// y compras con cuenta acumulen en el mismo registro de fidelidad.
model Fidelidad {
  id                   String   @id @default(cuid())
  userId               String?  @unique @map("user_id")
  telefono             String   @unique
  puntosAcumulados     Int      @default(0) @map("puntos_acumulados")
  ultimaActualizacion  DateTime @updatedAt @map("ultima_actualizacion")

  user         User?                 @relation(fields: [userId], references: [id])
  movimientos  MovimientoFidelidad[]

  @@map("fidelidad")
}

model MovimientoFidelidad {
  id           String                   @id @default(cuid())
  fidelidadId  String                   @map("fidelidad_id")
  pedidoId     String?                  @map("pedido_id")
  puntos       Int
  tipo         TipoMovimientoFidelidad
  fecha        DateTime                 @default(now())

  fidelidad Fidelidad @relation(fields: [fidelidadId], references: [id], onDelete: Cascade)
  pedido    Pedido?   @relation(fields: [pedidoId], references: [id])

  @@index([fidelidadId])
  @@index([pedidoId])
  @@map("movimientos_fidelidad")
}
