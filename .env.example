# Copia este archivo a .env y completa los valores reales (.env nunca se sube a git).

# Connection string PARA LA APP (runtime) — usar el pooler de Supabase (Supavisor),
# puerto 6543, modo "Transaction". En Supabase: Project Settings > Database > Connection string > Transaction.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connection string PARA MIGRACIONES (prisma migrate / introspect) — conexión directa,
# puerto 5432, sin pooler. En Supabase: Project Settings > Database > Connection string > Direct connection.
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres"
