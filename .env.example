# Copia este archivo a .env y completa los valores reales (.env nunca se sube a git).

# Connection string PARA LA APP (runtime) — transaction-mode pooler (IPv4).
# En Supabase: Connect > ORM > Prisma, o Project Settings > Database > Connection pooling.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connection string PARA MIGRACIONES (prisma migrate / db seed) — session-mode pooler (IPv4).
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Secreto para firmar las sesiones de NextAuth. Genera uno distinto por entorno con:
# node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET="reemplaza-con-un-valor-aleatorio-de-al-menos-32-caracteres"
